# ==================== 应用配置 ====================
APP_NAME=StarryAurora
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-to-a-random-string

# ==================== 数据库 ====================
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/starry_aurora
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# ==================== Qdrant ====================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_SCHEMA=schema_embeddings
QDRANT_COLLECTION_QUERY_CACHE=query_cache

# ==================== Elasticsearch ====================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_SCHEMA=schema_meta

# ==================== LLM 配置 ====================
LLM_PROVIDER=openai
LLM_MODEL=qwen-plus
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Embedding 模型
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ==================== JWT ====================
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ==================== Celery ====================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ==================== CORS ====================
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ==================== 日志 ====================
LOG_LEVEL=INFO
LOG_FORMAT=json